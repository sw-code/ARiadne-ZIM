{
  "name": "ariadne-demo-app",
  "version": "1.0.0",
  "description": "ARiadne SDK - Augmented Reality navigation and guidance system for React Native",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "build": "npx expo prebuild",
    "prebuild": "npx shx rm -rf android/ ios/",
    "postbuild": "npx ts-node --project tsconfig.json ./scripts/patch-viro-missing-api-key.ts",
    "android": "npx expo run:android",
    "android:release": "npx expo run:android --variant release",
    "ios": "npx expo run:ios --device",
    "ios:release": "npx expo run:ios --device --configuration Release",
    "gen-glb": "npx ts-node --project tsconfig.json ./scripts/optimize-glb.ts ./assets-src ./assets/3d",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|flatbush|flatqueue)"
    ]
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^10.2.1",
    "@math.gl/core": "^4.1.0",
    "@math.gl/geospatial": "^4.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-vector-icons/lucide": "^12.2.0",
    "@react-navigation/native": "^7.1.16",
    "@react-navigation/native-stack": "^7.3.23",
    "@reactvision/react-viro": "2.58.1",
    "@reactvision/react-viro-onnx": "1.0.2",
    "babel-preset-expo": "~55.0.8",
    "expo": "~55.0.32",
    "expo-asset": "~55.0.20",
    "expo-audio": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-file-system": "~55.0.26",
    "expo-keep-awake": "~55.0.8",
    "expo-localization": "~55.0.19",
    "expo-location": "~55.1.15",
    "expo-network": "~55.0.18",
    "expo-sensors": "~55.0.19",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "flatbush": "^4.5.0",
    "geomagnetism": "^0.2.0",
    "html-to-text": "^9.0.5",
    "jest-matcher-deep-close-to": "^3.0.2",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-logs": "^5.5.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-timing-hooks": "^5.2.0",
    "use-debounce": "^10.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@gltf-transform/functions": "^4.3.0",
    "@math.gl/types": "^4.1.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.1",
    "@types/html-to-text": "^9.0.4",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~55.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "meshoptimizer": "^1.0.1",
    "mikktspace": "^1.1.1",
    "prettier": "^3.2.5",
    "typescript": "~5.9.2"
  }
}
